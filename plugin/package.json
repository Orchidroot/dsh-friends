{
  "name": "dsh-friends-plugin",
  "version": "0.8.1",
  "description": "Floating friends windows and private one-to-one text chats for DSH with a self-hosted service",
  "type": "module",
  "license": "MIT",
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "host.mjs", "chat.mjs", "stream.mjs", "client.js", "cordis.patch.yml", "README.md", "LICENSE", "locale/*.json", "icon.svg"],
  "engines": { "dsh": ">=0.2.1-rc.5 <0.3.0", "node": ">=22" },
  "peerDependencies": { "@deepseek-ai/schemastery": "^3.18.5" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-locale"] }
  }
}
